+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+void esp32_onewire_init(void);
+int esp32_onewire_pin(void);
+/* The guest drives the pin low (output enabled, level 0) or releases it. */
+void esp32_onewire_drive(bool low);

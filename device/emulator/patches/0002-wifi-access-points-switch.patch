@@ -70,6 +70,44 @@ access_point_info access_points[]={
 
 int nb_aps=sizeof(access_points)/sizeof(access_point_info);
 
+static bool radio_down;
+static int64_t radio_checked = -NANOSECONDS_PER_SECOND;
+
+#define DEAUTH_REPEATS 5
+
+static bool radio_off(void)
+{
+    return radio_down;
+}
+
+static void poll_radio_state(void)
+{
+    const char *path = getenv("ESP32_WIFI_STATE_FILE");
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (!path || now - radio_checked < NANOSECONDS_PER_SECOND) {
+        return;
+    }
+    radio_checked = now;
+    gchar *text = NULL;
+    bool down = g_file_get_contents(path, &text, NULL, NULL) && g_str_has_prefix(g_strstrip(text), "off");
+    g_free(text);
+    if (down != radio_down) {
+        printf("esp32_wifi: access points %s\n", down ? "off" : "on");
+        fflush(stdout);
+    }
+    radio_down = down;
+}
+
+static void send_deauth(Esp32WifiState *s)
+{
+    struct mac80211_frame *frame = Esp32_WLAN_create_deauthentication();
+    frame->signal_strength = -30;
+    memcpy(frame->destination_address, BROADCAST, 6);
+    memcpy(s->ap_macaddr, s->associated_ap_macaddr, 6);
+    Esp32_WLAN_init_ap_frame(s, frame);
+    Esp32_WLAN_insert_frame(s, frame);
+}

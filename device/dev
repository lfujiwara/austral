#!/usr/bin/env bash
set -euo pipefail
# Generated files hold passwords and keys.
umask 077

root="$(cd "$(dirname "$0")" && pwd)"
local_dir="$root/.local"
tls_dir="$local_dir/tls"
control_dir="$local_dir/control"
run_dir="$local_dir/run"
firmware_dir="$local_dir/firmware"
flash="$local_dir/flash.bin"
qemu="$root/emulator/.build/qemu/build/qemu-system-xtensa"
esphome="$local_dir/venv/bin/esphome"
esphome_version="2026.9.1"
dependency_cutoff="2026-11-03"
http_port="${AUSTRAL_HTTP_PORT:-8080}"
device_web_port="${AUSTRAL_DEVICE_WEB_PORT:-18080}"

air_rom="0x81A1000000000228"

usage() {
  cat <<EOF
usage: ./dev <command>

  setup              check host tools, build the emulator, install ESPHome and the server
  build              compile the firmware for the emulator and write a fresh flash image
  ota                compile the firmware and send it to the running emulated device over OTA
  up                 start the server and the emulated device in the background
  down               stop them
  server             run the server in the foreground
  emulate            run the emulated device in the foreground
  temps T            set the air temperature (°C, or "unplugged")
  wifi on|off        switch the emulated access points
  scenario NAME      run scenarios/NAME.sh (warm-up, sensor-unplug, wifi-drop)
  test               end-to-end test in the emulator
  logs               follow the device serial log
  lan prepare        certificate, user and password, and firmware/secrets.yaml for the home network
  lan serve          MQTT TLS broker and chart on the home network
EOF
}

need() {
  command -v "$1" > /dev/null || { echo "missing $1: $2" >&2; exit 1; }
}

ensure_ca() {
  umask 077
  mkdir -p "$tls_dir"
  # A new CA would invalidate the one compiled into existing firmware, so keep it when present.
  [ -f "$tls_dir/ca.pem" ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 \
    -subj "/CN=austral-dev-ca" -keyout "$tls_dir/ca.key" -out "$tls_dir/ca.pem" >/dev/null 2>&1
}

# $2=force reissues the server certificate. The CA stays.
issue_server_cert() {
  local san=$1 force=${2:-}
  ensure_ca
  if [ "$force" != "force" ] && [ -f "$tls_dir/server.pem" ]; then
    return
  fi
  if [ "$force" = "force" ] && [ -f "$tls_dir/san.list" ] && [ "$(cat "$tls_dir/san.list")" = "$san" ] && [ -f "$tls_dir/server.pem" ]; then
    return
  fi
  local cn
  cn=$(printf '%s' "$san" | tr ',' '\n' | awk -F: '/^DNS:/ && /\.local$/ { print substr($0, 5); exit }')
  [ -n "$cn" ] || cn="austral-broker"
  openssl req -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj "/CN=${cn}" \
    -keyout "$tls_dir/server.key" -out "$tls_dir/server.csr" >/dev/null 2>&1 \
    || { echo "Falha ao emitir o certificado." >&2; exit 1; }
  printf 'subjectAltName=%s\nbasicConstraints=CA:FALSE\n' "$san" > "$tls_dir/ext.cnf"
  openssl x509 -req -in "$tls_dir/server.csr" -CA "$tls_dir/ca.pem" -CAkey "$tls_dir/ca.key" \
    -CAcreateserial -days 3650 -extfile "$tls_dir/ext.cnf" -out "$tls_dir/server.pem" >/dev/null 2>&1 \
    || { echo "Falha ao emitir o certificado." >&2; exit 1; }
  rm -f "$tls_dir/server.csr"
  printf '%s\n' "$san" > "$tls_dir/san.list"
  chmod 600 "$tls_dir/server.key" "$tls_dir/ca.key" "$tls_dir/server.pem" "$tls_dir/ca.pem"
}

ensure_tls() {
  # The emulated device reaches the host at 192.168.4.2.
  issue_server_cert "IP:192.168.4.2,IP:127.0.0.1"
}

ensure_credentials() {
  [ -f "$local_dir/credentials.env" ] && return
  mkdir -p "$local_dir"
  (
    umask 077
    {
      echo "AUSTRAL_MQTT_USERNAME=device"
      echo "AUSTRAL_MQTT_PASSWORD=$(openssl rand -hex 16)"
      echo "AUSTRAL_OTA_PASSWORD=$(openssl rand -hex 16)"
      echo "AUSTRAL_FALLBACK_PASSWORD=$(openssl rand -hex 16)"
    } > "$local_dir/credentials.env"
  )
}

load_credentials() {
  ensure_credentials
  set -a
  # shellcheck disable=SC1091
  . "$local_dir/credentials.env"
  set +a
}

set_temps() {
  mkdir -p "$control_dir"
  local file="$control_dir/temperatures.txt" value="$1"
  : > "$file.next"
  if [ "$value" != "unplugged" ]; then
    if ! [[ "$value" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || ! awk -v t="$value" 'BEGIN { exit !(t >= -55 && t <= 125) }'; then
      echo "temperature must be between -55 and 125 °C, or unplugged: $value" >&2
      rm -f "$file.next"
      exit 1
    fi
    echo "$air_rom $value" >> "$file.next"
  fi
  mv "$file.next" "$file"
}

set_wifi() {
  mkdir -p "$control_dir"
  case "$1" in
    on|off) echo "$1" > "$control_dir/wifi.txt.next" && mv "$control_dir/wifi.txt.next" "$control_dir/wifi.txt" ;;
    *) echo "wifi takes on or off" >&2; exit 1 ;;
  esac
}

cmd_setup() {
  for tool in brew git node npm openssl uv truncate; do need "$tool" "install it first"; done
  local missing=()
  for formula in glib pixman libgcrypt libslirp meson ninja pkgconf; do
    brew list --versions "$formula" > /dev/null || missing+=("$formula")
  done
  [ ${#missing[@]} -eq 0 ] || brew install "${missing[@]}"
  "$root/emulator/build.sh" > /dev/null
  if ! { [ -x "$esphome" ] && "$esphome" version | grep -q -F "$esphome_version"; }; then
    uv venv --quiet --python 3.13 "$local_dir/venv"
    VIRTUAL_ENV="$local_dir/venv" uv pip install --quiet --exclude-newer "$dependency_cutoff" "esphome==$esphome_version"
  fi
  (cd "$root/server" && npm ci --no-audit --no-fund --silent)
  ensure_tls
  ensure_credentials
  echo "setup done"
}

compile_firmware() {
  [ -x "$esphome" ] || { echo "run ./dev setup first" >&2; exit 1; }
  ensure_tls
  load_credentials
  mkdir -p "$firmware_dir"
  cp "$root/firmware/device.yaml" "$firmware_dir/device.yaml"
  mkdir -p "$firmware_dir/packages"
  cp "$root/firmware/packages/"*.yaml "$firmware_dir/packages/"
  cat > "$firmware_dir/emulator.yaml" <<'EOF'
packages:
  device: !include device.yaml

logger:
  level: DEBUG
EOF
  {
    echo 'wifi_ssid: "PICSimLabWifi"'
    echo 'wifi_password: ""'
    echo "fallback_password: \"$AUSTRAL_FALLBACK_PASSWORD\""
    echo "ota_password: \"$AUSTRAL_OTA_PASSWORD\""
    echo 'mqtt_broker: "192.168.4.2"'
    echo "mqtt_username: \"$AUSTRAL_MQTT_USERNAME\""
    echo "mqtt_password: \"$AUSTRAL_MQTT_PASSWORD\""
    echo "air_sensor_address: \"$air_rom\""
    echo 'mqtt_ca: |'
    sed 's/^/  /' "$tls_dir/ca.pem"
  } > "$firmware_dir/secrets.yaml"
  (cd "$firmware_dir" && "$esphome" compile emulator.yaml > "$firmware_dir/compile.log" 2>&1) || {
    tail -20 "$firmware_dir/compile.log" >&2
    exit 1
  }
}

cmd_build() {
  [ -z "$(running_pid device)" ] || { echo "the emulated device is running; use ./dev ota, or ./dev down first" >&2; exit 1; }
  compile_firmware
  local image="$firmware_dir/.esphome/build/austral-device/build/firmware.factory.bin"
  [ "$(wc -c < "$image")" -le 4194304 ] || { echo "firmware image larger than the 4 MB flash" >&2; exit 1; }
  cp "$image" "$flash"
  truncate -s 4M "$flash"
  echo "flash image: $flash"
}

ensure_control() {
  [ -f "$control_dir/temperatures.txt" ] || set_temps -21.25
  [ -f "$control_dir/wifi.txt" ] || set_wifi on
}

cmd_server() {
  ensure_tls
  load_credentials
  [ -d "$root/server/node_modules" ] || { echo "run ./dev setup first" >&2; exit 1; }
  AUSTRAL_TLS_DIR="$tls_dir" AUSTRAL_HTTP_PORT="$http_port" exec node "$root/server/server.mjs"
}

detect_lan_ip() {
  if [ -n "${AUSTRAL_LAN_IP:-}" ]; then
    printf '%s\n' "$AUSTRAL_LAN_IP"
    return
  fi
  local iface ip
  if command -v route >/dev/null 2>&1 && route -n get default >/dev/null 2>&1; then
    iface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')
    if [ -n "$iface" ] && command -v ipconfig >/dev/null 2>&1; then
      ip=$(ipconfig getifaddr "$iface" 2>/dev/null || true)
      if [ -n "$ip" ]; then printf '%s\n' "$ip"; return; fi
    fi
  fi
  if command -v ipconfig >/dev/null 2>&1; then
    for iface in en0 en1; do
      ip=$(ipconfig getifaddr "$iface" 2>/dev/null || true)
      if [ -n "$ip" ]; then printf '%s\n' "$ip"; return; fi
    done
  fi
  if command -v route >/dev/null 2>&1 && command -v ifconfig >/dev/null 2>&1; then
    iface=$(route -n 2>/dev/null | awk '$1 == "0.0.0.0" { print $8; exit }')
    if [ -n "$iface" ]; then
      ip=$(ifconfig "$iface" 2>/dev/null | awk '/inet /{ print $2; exit }')
      ip=${ip#addr:}
      if [ -n "$ip" ]; then printf '%s\n' "$ip"; return; fi
    fi
  fi
  if command -v hostname >/dev/null 2>&1; then
    ip=$(hostname -I 2>/dev/null | awk '{ print $1 }' || true)
    if [ -n "$ip" ]; then printf '%s\n' "$ip"; return; fi
  fi
  if command -v ip >/dev/null 2>&1; then
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
    if [ -n "$ip" ]; then printf '%s\n' "$ip"; return; fi
  fi
  return 1
}

detect_mdns() {
  if [ -n "${AUSTRAL_LAN_MDNS:-}" ]; then
    printf '%s\n' "${AUSTRAL_LAN_MDNS%.local}.local"
    return
  fi
  local name=""
  if command -v scutil >/dev/null 2>&1; then
    name=$(scutil --get LocalHostName 2>/dev/null || true)
  fi
  if [ -z "$name" ]; then
    name=$(hostname -s 2>/dev/null || hostname)
  fi
  name=${name%.local}
  name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9-' '-' | sed 's/^-*//;s/-*$//')
  [ -n "$name" ] || name="austral"
  printf '%s.local\n' "$name"
}

valid_ipv4() {
  local ip=$1 octet
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  [ "$ip" != "127.0.0.1" ] && [ "$ip" != "0.0.0.0" ] || return 1
  IFS=. read -r o1 o2 o3 o4 <<< "$ip"
  for octet in "$o1" "$o2" "$o3" "$o4"; do
    [ "$octet" -le 255 ] || return 1
  done
}

valid_mdns() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]
}

lan_identity() {
  lan_ip=$(detect_lan_ip) || { echo "Não achei o IP da rede. Defina AUSTRAL_LAN_IP." >&2; exit 1; }
  valid_ipv4 "$lan_ip" || { echo "IP da rede inválido. Defina AUSTRAL_LAN_IP." >&2; exit 1; }
  lan_mdns=$(detect_mdns)
  valid_mdns "$lan_mdns" || { echo "Nome .local inválido. Defina AUSTRAL_LAN_MDNS." >&2; exit 1; }
  lan_san="IP:127.0.0.1,IP:192.168.4.2,IP:${lan_ip},DNS:localhost,DNS:${lan_mdns}"
}

ensure_server_modules() {
  [ -d "$root/server/node_modules" ] && return
  need npm "install Node.js with npm"
  (cd "$root/server" && npm ci --no-audit --no-fund --silent)
}

prompt_wifi() {
  [ -t 0 ] || return 0
  [ -z "${AUSTRAL_WIFI_SSID:-}" ] || return 0
  local current=""
  if [ -f "$root/firmware/secrets.yaml" ]; then
    current=$(awk -F'"' '/^wifi_ssid:/{print $2; exit}' "$root/firmware/secrets.yaml")
  fi
  if [ -n "$current" ] && [ "$current" != "YOUR_2_4_GHZ_NETWORK" ]; then
    return 0
  fi
  local ssid password
  read -r -p "Wi-Fi de 2,4 GHz: " ssid
  [ -n "$ssid" ] || return 0
  read -r -s -p "Senha do Wi-Fi: " password
  printf '\n' >&2
  [ -n "$password" ] || return 0
  AUSTRAL_WIFI_SSID=$ssid
  AUSTRAL_WIFI_PASSWORD=$password
  export AUSTRAL_WIFI_SSID AUSTRAL_WIFI_PASSWORD
}

write_lan_secrets() {
  load_credentials
  local status
  status=$(
    AUSTRAL_SECRETS_FILE="$root/firmware/secrets.yaml" \
    AUSTRAL_SECRETS_EXAMPLE="$root/firmware/example.secrets.yaml" \
    AUSTRAL_CA_FILE="$tls_dir/ca.pem" \
    AUSTRAL_MQTT_BROKER="$lan_ip" \
    node "$root/lan-secrets.mjs"
  )
  case "$status" in
    wifi=ready) ;;
    wifi=missing) echo "Preencha wifi_ssid e wifi_password em firmware/secrets.yaml." ;;
    *) echo "Falha ao escrever firmware/secrets.yaml." >&2; exit 1 ;;
  esac
}

cmd_lan_prepare() {
  need openssl "install it first"
  need node "install Node 20.11 or newer"
  lan_identity
  issue_server_cert "$lan_san" force
  ensure_server_modules
  prompt_wifi
  write_lan_secrets
  echo "IP: $lan_ip"
  echo "Nome: $lan_mdns"
  echo "Broker MQTT: ${lan_ip}:8883"
  echo "Certificado: .local/tls/server.pem"
  echo "Secrets: firmware/secrets.yaml"
  echo "Usuário e senha ficam em .local/credentials.env e em firmware/secrets.yaml."
}

cmd_lan_serve() {
  need openssl "install it first"
  need node "install Node 20.11 or newer"
  lan_identity
  [ -f "$root/firmware/secrets.yaml" ] || { echo "Rode ./dev lan prepare antes de gravar a placa." >&2; exit 1; }
  issue_server_cert "$lan_san" force
  ensure_server_modules
  load_credentials
  local flashed
  flashed=$(awk -F'"' '/^mqtt_broker:/{print $2; exit}' "$root/firmware/secrets.yaml")
  if [ -n "$flashed" ] && [ "$flashed" != "$lan_ip" ]; then
    echo "O secrets.yaml aponta para ${flashed} e este computador está em ${lan_ip}." >&2
    echo "Rode ./dev lan prepare de novo e grave o firmware outra vez." >&2
  fi
  echo "Broker MQTT: ${lan_ip}:8883"
  echo "Gráfico: http://${lan_ip}:${http_port}"
  echo "Nome na rede: ${lan_mdns}"
  AUSTRAL_BIND=0.0.0.0 \
  AUSTRAL_LAN_HOSTS="${lan_ip},${lan_mdns}" \
  AUSTRAL_TLS_DIR="$tls_dir" \
  AUSTRAL_HTTP_PORT="$http_port" \
  exec node "$root/server/server.mjs"
}

cmd_ota() {
  compile_firmware
  [ -n "$(running_pid device)" ] || { echo "the emulated device is not running; ./dev up first" >&2; exit 1; }
  (cd "$firmware_dir" && "$esphome" upload emulator.yaml --device 127.0.0.1 > "$firmware_dir/upload.log" 2>&1) || {
    tail -20 "$firmware_dir/upload.log" >&2
    exit 1
  }
  echo "OTA update sent; the device reboots into the new firmware"
}

cmd_emulate() {
  [ -x "$qemu" ] || { echo "run ./dev setup first" >&2; exit 1; }
  [ -f "$flash" ] || { echo "run ./dev build first" >&2; exit 1; }
  if [ -n "$(running_pid device)" ] && [ "$(running_pid device)" != "$$" ]; then
    echo "the emulated device is already running" >&2
    exit 1
  fi
  mkdir -p "$run_dir"
  echo $$ > "$run_dir/device.pid"
  ensure_control
  ESP32_ONEWIRE_PIN=4 \
  ESP32_ONEWIRE_FILE="$control_dir/temperatures.txt" \
  ESP32_WIFI_STATE_FILE="$control_dir/wifi.txt" \
  exec "$qemu" -nographic -machine esp32-picsimlab \
    -icount shift=3,align=off,sleep=on \
    -drive "file=$flash,if=mtd,format=raw" \
    -global driver=timer.esp32.timg,property=wdt_disable,value=true \
    -nic "user,model=esp32_wifi,net=192.168.4.0/24,hostfwd=tcp:127.0.0.1:$device_web_port-192.168.4.15:80,hostfwd=tcp:127.0.0.1:3232-192.168.4.15:3232"
}

running_pid() {
  local pid_file="$run_dir/$1.pid" pid
  [ -f "$pid_file" ] || return 0
  pid="$(cat "$pid_file")"
  if ps -p "$pid" -o command= 2> /dev/null | grep -q -F "$root"; then
    echo "$pid"
  else
    rm -f "$pid_file"
  fi
}

start_background() {
  local name="$1"
  shift
  if [ -n "$(running_pid "$name")" ]; then
    echo "$name already running"
    return
  fi
  mkdir -p "$run_dir"
  nohup "$@" < /dev/null > "$run_dir/$name.log" 2>&1 &
  echo $! > "$run_dir/$name.pid"
  sleep 1
  [ -n "$(running_pid "$name")" ] || { echo "$name exited; see $run_dir/$name.log" >&2; tail -5 "$run_dir/$name.log" >&2; exit 1; }
}

cmd_up() {
  start_background server "$0" server
  start_background device "$0" emulate
  echo "chart:      http://127.0.0.1:$http_port"
  echo "device web: http://127.0.0.1:$device_web_port"
  echo "serial log: $run_dir/device.log"
}

cmd_down() {
  local name pid
  for name in device server; do
    pid="$(running_pid "$name")"
    [ -n "$pid" ] || continue
    kill "$pid" 2> /dev/null || true
    for _ in $(seq 50); do
      kill -0 "$pid" 2> /dev/null || break
      sleep 0.1
    done
    kill -9 "$pid" 2> /dev/null || true
    rm -f "$run_dir/$name.pid"
  done
}

cmd_scenario() {
  local script="$root/scenarios/${1:-}.sh"
  [ -f "$script" ] || { echo "unknown scenario; see scenarios/" >&2; exit 1; }
  DEV="$0" exec bash "$script"
}

command="${1:-}"
[ $# -gt 0 ] && shift
case "$command" in
  setup) cmd_setup ;;
  build) cmd_build ;;
  ota) cmd_ota ;;
  up) cmd_up ;;
  down) cmd_down ;;
  server) cmd_server ;;
  emulate) cmd_emulate ;;
  temps) [ $# -eq 1 ] || { usage; exit 1; }; set_temps "$1" ;;
  wifi) [ $# -eq 1 ] || { usage; exit 1; }; set_wifi "$1" ;;
  scenario) cmd_scenario "$@" ;;
  test) exec node "$root/test/e2e.mjs" ;;
  logs) exec tail -f "$run_dir/device.log" ;;
  lan)
    case "${1:-}" in
      prepare) cmd_lan_prepare ;;
      serve) cmd_lan_serve ;;
      *) echo "usage: ./dev lan prepare|serve" >&2; exit 1 ;;
    esac
    ;;
  *) usage; [ -z "$command" ] || exit 1 ;;
esac
